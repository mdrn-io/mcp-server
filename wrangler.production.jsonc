// The hosted MCP server for the production stage at https://mcp.mdrn.io/mcp (worker "mcp" in
// infra/cloudflare/production/manifest.json), released by Deploy like every other Worker. Wrangler
// bundles src/worker.js itself: it imports nothing outside mcp/src but package.json (its version), so there is no build step.
// The route keeps the hostname from production Proxy's */* (routes run before custom domains),
// and the custom domain gives it its DNS record. It holds no credential for the API: each request's bearer is
// checked with Platform over its one binding, PLATFORM, and forwarded to API_ORIGIN for the tools
// (src/worker.js); the binding also carries its signed Alert when token checks keep failing (src/alert.js).
// Observability keeps failures only, never a request record.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mdrn-mcp-production",
  "main": "src/worker.js",
  "account_id": "a7e532b233018ae8525bb587f920bd18",
  "compatibility_date": "2026-09-17",
  // API_ORIGIN (the tools' calls) is served by another Worker of our own account: without this
  // flag Cloudflare refuses the fetch (error 1042).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "mcp.mdrn.io/*", "zone_name": "mdrn.io" },
    { "pattern": "mcp.mdrn.io", "custom_domain": true }
  ],
  "vars": {
    "STAGE": "production",
    // The resource every token must be issued for (or none), and Platform, its authorization server.
    "MCP_RESOURCE": "https://mcp.mdrn.io/mcp",
    "API_ORIGIN": "https://api.mdrn.io"
  },
  // The token check, and the Alert, which MCP_ALERT_KEY (optional, infra/cloudflare/secrets.json) signs.
  "services": [{ "binding": "PLATFORM", "service": "mdrn-platform-production" }],
  // Requests per client address a minute, counted before a token is checked with Platform (src/worker.js).
  "ratelimits": [{ "name": "MCP_LIMITER", "namespace_id": "1231", "simple": { "limit": 300, "period": 60 } }],
  // Only the Worker's own lines (a failed token check, src/alert.js): no record per request, so
  // no request headers in Workers Logs and no line billed per call.
  "observability": { "enabled": true, "logs": { "invocation_logs": false, "head_sampling_rate": 1 } }
}
